{$FAE_COORDINATOR_DOMAIN} {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    X-Frame-Options "DENY"
    -Server
  }

  reverse_proxy coordinator:3190 {
    health_uri /health
    health_interval 30s
    health_timeout 5s
  }

  log {
    output stdout
    format console
  }
}
