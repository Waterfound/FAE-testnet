FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production \
    FAE_COORDINATOR_HOST=0.0.0.0 \
    FAE_COORDINATOR_PORT=3190 \
    FAE_COORDINATOR_DATA_DIR=/data
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY fae-share-coordinator-v1-candidate.mjs ./
COPY authoritative ./authoritative
RUN mkdir -p /data && chown -R node:node /app /data
USER node
EXPOSE 3190
VOLUME ["/data"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD node -e "fetch('http://127.0.0.1:3190/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node","fae-share-coordinator-v1-candidate.mjs"]
