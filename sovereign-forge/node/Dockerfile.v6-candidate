FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY fae-node-v6-candidate.mjs ./
COPY authoritative ./authoritative
ENV FAE_HOST=0.0.0.0 \
    FAE_PORT=8787 \
    FAE_DATA_FILE=/data/fae-v6-state.json \
    FAE_IDENTITY_FILE=/data/fae-node-identity.json \
    FAE_PEER_TRUST_FILE=/data/fae-peer-trust.json \
    FAE_SYNC=1
VOLUME ["/data"]
EXPOSE 8787
USER node
CMD ["node","fae-node-v6-candidate.mjs"]
