{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fairyelf.invalid/schemas/red-team/attack.v0.0.1.schema.json",
  "title": "FAE Red Team attack v0.0.1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "id",
    "version",
    "title",
    "domain",
    "failure_class",
    "severity",
    "executor",
    "oracle",
    "evidence_requirements"
  ],
  "properties": {
    "schema_version": {"const": "fae.red-team.attack.v0.0.1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._~/-]{2,127}$"},
    "version": {"const": "0.0.1"},
    "title": {"type": "string", "minLength": 1},
    "domain": {
      "enum": [
        "consensus",
        "activation",
        "p2p",
        "difficulty_timestamp",
        "persistence",
        "coordinator",
        "wallet_client",
        "release_integrity",
        "availability",
        "meta"
      ]
    },
    "failure_class": {"type": "string", "minLength": 1},
    "severity": {"enum": ["critical", "high", "medium", "low"]},
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "argv", "cwd", "timeout_ms", "max_output_bytes", "network", "stdin"],
      "properties": {
        "kind": {"const": "process"},
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "cwd": {"type": "string", "minLength": 1},
        "timeout_ms": {"type": "integer", "minimum": 100, "maximum": 600000},
        "max_output_bytes": {"type": "integer", "minimum": 1024, "maximum": 10485760},
        "network": {"const": "deny"},
        "stdin": {"enum": ["none", "payload-json"]},
        "capture_excerpt": {"const": false}
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "defended_exit_code"],
      "properties": {
        "kind": {"const": "exit-code-defense"},
        "defended_exit_code": {"type": "integer", "minimum": 0, "maximum": 255}
      }
    },
    "evidence_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
