{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fairyelf.invalid/schemas/red-team/lock.v0.0.1.schema.json",
  "title": "FAE Red Team frozen lock v0.0.1",
  "type": "object",
  "required": [
    "schema_version",
    "engine_version",
    "frozen_at",
    "campaign",
    "target",
    "authority_boundary",
    "blind",
    "taxonomy",
    "score_policy",
    "attacks",
    "source_digests",
    "lock_digest"
  ],
  "properties": {
    "schema_version": {"const": "fae.red-team.lock.v0.0.1"},
    "engine_version": {"const": "0.0.1"},
    "frozen_at": {"type": "string", "format": "date-time"},
    "attacks": {"type": "array", "minItems": 1},
    "lock_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
