{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fairyelf.invalid/schemas/red-team/holdout-commitments.v0.0.1.schema.json",
  "title": "FAE Red Team public holdout commitments v0.0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "set_id", "status", "cases", "set_digest"],
  "properties": {
    "schema_version": {"const": "fae.red-team.holdout-commitments.v0.0.1"},
    "set_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["active", "retired"]},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "domain", "severity", "commitment", "input_public"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "domain": {"type": "string", "minLength": 1},
          "severity": {"enum": ["critical", "high", "medium", "low"]},
          "commitment": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "input_public": {}
        }
      }
    },
    "retirement": {
      "type": "object",
      "required": ["reviewer", "retired_at", "reason"],
      "properties": {
        "reviewer": {"type": "string", "minLength": 1},
        "retired_at": {"type": "string", "format": "date-time"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "set_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
